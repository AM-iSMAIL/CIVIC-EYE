# ==============================================================================
# CivicEye - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your production or local keys.
# NEVER commit .env.local or expose production secrets in version control.

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration (Phase 2)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Google Maps Platform Configuration (Phase 2)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id_here

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Phase 2)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# FastAPI Backend Configuration (Phase 3)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
